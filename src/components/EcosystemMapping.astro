---
import { siteContent } from '../data/siteContent';
import FadeIn from './FadeIn';
import EcosystemDiagram from './EcosystemDiagram';
---
<section id="ecosystem" class="py-24 bg-gradient-to-b from-brand-primary from-50% to-brand-secondary/20 px-6 lg:px-8 border-t border-white/10">
  <div class="max-w-[1024px] mx-auto overflow-hidden">
    <FadeIn client:visible>
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-3xl font-bold mb-4 text-white">Ecosystem Mapping</h2>
        <p class="text-gray-400 text-lg">4 pilar utama yang terhubung untuk mendukung visi pertumbuhan berkelanjutan.</p>
      </div>
    </FadeIn>
    
    <EcosystemDiagram client:visible pillars={siteContent.ecosystemPillars} />
  </div>
</section>
