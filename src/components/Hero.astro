---
import { siteContent } from '../data/siteContent';
import { ArrowRight } from 'lucide-preact';
import FadeIn from './FadeIn';
---
<section class="relative pt-24 pb-32 overflow-hidden px-6 lg:px-8 bg-gradient-to-br from-brand-secondary/40 via-brand-primary to-brand-primary text-text-on-dark">
  <div class="max-w-[1024px] mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div class="max-w-2xl relative z-10">
      <FadeIn client:load delay={0}>
        <h1 class="text-4xl md:text-[3rem] leading-[1.15] font-bold tracking-tight mb-6 text-white">
          {siteContent.hero.headline}
        </h1>
      </FadeIn>
      <FadeIn client:load delay={150}>
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-10 max-w-xl">
          {siteContent.hero.subheadline}
        </p>
      </FadeIn>
      <FadeIn client:load delay={300}>
      <div class="flex flex-col sm:flex-row gap-4">
        <a 
          href={siteContent.hero.primaryCTA.url}
          class="inline-flex items-center justify-center bg-brand-secondary text-white font-semibold px-8 py-4 rounded-md hover:opacity-90 transition-all shadow-sm gap-2"
        >
          {siteContent.hero.primaryCTA.label}
          <ArrowRight className="w-4 h-4" />
        </a>
        <a 
          href={siteContent.hero.secondaryCTA.url}
          class="inline-flex items-center justify-center bg-transparent border-2 border-white text-white font-semibold px-8 py-4 rounded-md hover:bg-white hover:text-brand-primary transition-all"
        >
          {siteContent.hero.secondaryCTA.label}
        </a>
      </div>
      </FadeIn>
    </div>
    <div class="relative hidden lg:block">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl relative z-10">
        <div class="absolute inset-0 bg-brand-primary/10 group-hover:bg-transparent transition-colors z-20"></div>
        <img 
          src={siteContent.media.heroPortrait} 
          alt="Prima Yoga Lan - Professional Portrait" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="absolute -bottom-8 -right-8 w-64 h-64 bg-brand-secondary/20 rounded-full blur-3xl -z-10"></div>
    </div>
  </div>
</section>
