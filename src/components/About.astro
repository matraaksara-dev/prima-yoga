---
import { siteContent } from '../data/siteContent';
import FadeIn from './FadeIn';
---
<section id="about" class="py-24 bg-brand-primary px-6 lg:px-8">
  <div class="max-w-[1024px] mx-auto">
    <FadeIn client:visible>
      <h2 class="text-3xl font-bold mb-12 text-text-primary">Filosofi & Perjalanan</h2>
    </FadeIn>
    <div class="grid md:grid-cols-[1fr_2fr] gap-12 items-start">
      <FadeIn client:visible delay={150}>
        <div class="text-2xl font-serif leading-snug font-medium text-brand-accent">
          "{siteContent.about.openingHook}"
        </div>
      </FadeIn>
      <FadeIn client:visible delay={300}>
        <div class="space-y-6 text-text-muted leading-relaxed">
          <p>{siteContent.about.journey}</p>
          <p>{siteContent.about.approach}</p>
          <p>{siteContent.about.vision}</p>
          <p class="font-medium text-text-primary mt-8 text-lg">{siteContent.about.closingLine}</p>
        </div>
      </FadeIn>
    </div>
  </div>
</section>
