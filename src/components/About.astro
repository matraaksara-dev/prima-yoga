---
import { siteContent } from '../data/siteContent';
import FadeIn from './FadeIn';
import VerticalTimeline from './VerticalTimeline';
---
<section id="about" class="py-24 bg-brand-primary px-6 lg:px-8">
  <div class="max-w-[1024px] mx-auto">
    <FadeIn client:visible>
      <h2 class="text-3xl font-bold mb-16 text-white text-center">Filosofi & Perjalanan</h2>
    </FadeIn>
    
    <FadeIn client:visible delay={150}>
      <div class="text-2xl md:text-3xl lg:text-4xl font-serif leading-snug font-medium text-brand-secondary text-center max-w-4xl mx-auto mb-20 italic">
        "{siteContent.about.quote}"
      </div>
    </FadeIn>
    
    <div class="mb-20">
      <VerticalTimeline client:visible timeline={siteContent.about.timeline} />
    </div>
    
    <FadeIn client:visible delay={300}>
      <div class="text-center">
        <p class="font-medium text-white text-xl">{siteContent.about.closingLine}</p>
      </div>
    </FadeIn>
  </div>
</section>
