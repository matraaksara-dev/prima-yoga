---
import { siteContent } from '../data/siteContent';
import FadeIn from './FadeIn';
---
<section id="services" class="py-24 px-6 lg:px-8 border-y border-black bg-gradient-to-b from-brand-secondary/20 via-brand-primary to-brand-primary">
  <div class="max-w-[1024px] mx-auto">
    <FadeIn client:visible>
      <h2 class="text-3xl font-bold mb-16 text-center text-white">Pilar Layanan Strategis</h2>
    </FadeIn>
    <div class="grid md:grid-cols-3 gap-8">
      {siteContent.services.map((service, idx) => (
        <FadeIn client:visible delay={idx * 150}>
          <div class="bg-brand-primary/40 border border-white/5 p-8 rounded-lg hover:-translate-y-1 hover:shadow-[0_0_20px_theme('colors.brand.secondary'/30)] transition-all duration-200 ease-out group hover:border-brand-secondary relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-brand-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            <div class="w-12 h-12 bg-black/50 border border-white/10 rounded-md flex items-center justify-center mb-6 group-hover:bg-brand-secondary/20 group-hover:border-brand-secondary/50 transition-all duration-300">
              <span class="font-serif font-bold text-xl text-brand-secondary group-hover:scale-110 transition-transform duration-300">0{idx + 1}</span>
            </div>
            <h3 class="text-xl font-bold mb-4 font-serif text-white group-hover:text-brand-secondary transition-colors duration-300">{service.title}</h3>
            <p class="text-gray-400 leading-relaxed text-sm">{service.description}</p>
          </div>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
