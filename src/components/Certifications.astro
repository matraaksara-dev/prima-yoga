---
import { siteContent } from '../data/siteContent';
---
<div>
  <h2 class="text-3xl font-bold mb-10 text-text-primary">Lisensi & Sertifikasi</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {siteContent.certifications.map((cert) => (
      <div class="bg-bg p-5 rounded-md border border-border hover:border-brand-accent/30 transition-colors">
        <div class="text-xs font-semibold text-brand-accent mb-2 tracking-wider uppercase flex justify-between">
          <span>{cert.issuer}</span>
          <span>{cert.year}</span>
        </div>
        <h4 class="font-semibold text-text-primary text-sm leading-snug">{cert.name}</h4>
      </div>
    ))}
  </div>
</div>
